   "source": [
    "import yaml\\n",
    "import sys\\n",
    "with open('.github/workflows/deploy.yml', 'r') as f:\\n",
    "    data = yaml.safe_load(f)\\n",
    "print('YAML loaded successfully')\\n",
    "print('Keys:', list(data.keys()))\\n",
    "required = {'name', 'on', 'jobs'}\\n",
    "missing = required - set(data.keys())\\n",
    "if missing:\\n",
    "    print('Missing required sections:', missing)\\n",
    "    sys.exit(1)\\n",
    "else:\\n",
    "    print('All required sections present')\\n",
    "    sys.exit(0)
   ]
  }
