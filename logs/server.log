0\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n17\tconst Alert = ({ msg, type, onClose }) =>\n18\t  msg ? (\n19\t    <div className={`as-alert ${type}`}>\n20\t      {msg}\n21\t      <button className=\"as-alert-close\" onClick={onClose}><FaTimes /></button>\n22\t    </div>\n23\t  ) : null;\n24\t\n25\t// \u2500\u2500\u2500 Main Component \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n26\tconst AdminSettings = () => {\n27\t  const [timeline, setTimeline]   = useState([]);\n28\t  const [team, setTeam]           = useState([]);\n29\t  const [loading, setLoading]     = useState({ timeline: true, team: true });\n30\t  const [saving, setSaving]       = useState({ timeline: false, team: false });\n31\t  const [alert, setAlert]         = useState({ timeline: null, team: null });\n32\t  const [error, setError]         = useState(null);\n33\t\n34\t  // Modal state shared\n35\t  const [tlModal, setTlModal]     = useState(false);\n36\t  const [tmModal, setTmModal]     = useState(false);\n37\t  const [selected, setSelected]   = useState(null);\n38\t  const [tlForm, setTlForm]       = useState(blankTimeline());\n39\t  const [tmForm, setTmForm]       = useState(blankMember());\n40\t\n41\t  const clearAlert = (key) => setAlert(p => ({ ...p, [key]: null }));\n42\t  const showAlert = (key, msg, type = 'success') => {\n43\t    setAlert(p => ({ ...p, [key]: { msg, type } }));\n44\t    setTimeout(() => clearAlert(key), 4000);\n45\t  };\n46\t\n47\t  // \u2500\u2500 Fetch Timeline \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n48\t  const fetchTimeline = useCallback(async () => {\n49\t    setLoading(p => ({ ...p, timeline: true }));\n50\t    try {\n51\t      const res = await apiService.get(API_ENDPOINTS.ADMIN.SETTINGS.TIMELINE);\n52\t      if (res.success) setTimeline(Array.isArray(res.data) ? res.data : (res.data?.data || []));\n53\t    } catch { setError('Failed to load timeline.'); }\n54\t    finally { setLoading(p => ({ ...p, timeline: false })); }\n55\t  }, []);\n56\t\n57\t  // \u2500\u2500 Fetch Team \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n58\t  const fetchTeam = useCallback(async () => {\n59\t    setLoading(p => ({ ...p, team: true }));\n60\t    try {\n61\t      const res = await apiService.get(API_ENDPOINTS.ADMIN.SETTINGS.TEAM);\n62\t      if (res.success) setTeam(Array.isArray(res.data) ? res.data : (res.data?.data || []));\n63\t    } catch { setError('Failed to load team members.'); }\n64\t    finally { setLoading(p => ({ ...p, team: false })); }\n65\t  }, []);\n66\t\n67\t  useEffect(() => { fetchTimeline(); fetchTeam(); }, [fetchTimeline, fetchTeam]);\n68\t\n69\t  // \u2500\u2500 Timeline CRUD \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n70\t  const openTlAdd  = () => { setSelected(null); setTlForm(blankTimeline()); setTlModal(true); };\n71\t  const openTlEdit = (item) => { setSelected(item); setTlForm({ year: item.year || '', title: item.title || '', description: item.description || '' }); setTlModal(true); };\n72\t\n73\t  const saveTl = async (e) => {\n74\t    e.preventDefault();\n75\t    setSaving(p => ({ ...p, timeline: true }));\n76\t    try {\n77\t      const res = selected\n78\t        ? await apiService.put(`${API_ENDPOINTS.ADMIN.SETTINGS.TIMELINE}/${selected.id}`, tlForm)\n79\t        : await apiService.post(API_ENDPOINTS.ADMIN.SETTINGS.TIMELINE, tlForm);\n80\t      if (res.success) { setTlModal(false); fetchTimeline(); showAlert('timeline', selected ? 'Timeline entry updated.' : 'Timeline entry added.'); }\n81\t      else showAlert('timeline', res.message || 'Save failed.', 'danger');\n82\t    } catch { showAlert('timeline', 'Failed to save timeline entry.', 'danger'); }\n83\t    finally { setSaving(p => ({ ...p, timeline: false })); }\n84\t  };\n85\t\n86\t  const deleteTl = async (item) => {\n87\t    if (!window.confirm(`Delete \"${item.title}\" (${item.year})?`)) return;\n88\t    try {\n89\t      await apiService.delete(`${API_ENDPOINTS.ADMIN.SETTINGS.TIMELINE}/${item.id}`);\n90\t      fetchTimeline(); showAlert('timeline', 'Entry deleted.');\n91\t    } catch { showAlert('timeline', 'Delete failed.', 'danger'); }\n92\t  };\n93\t\n94\t  const moveTl = (idx, dir) => {\n95\t    const arr = [...timeline];\n96\t    const target = idx + dir;\n97\t    if (target < 0 || target >= arr.length) return;\n98\t    [arr[idx], arr[target]] = [arr[target], arr[idx]];\n99\t    setTimeline(arr);\n100\t  };\n101\t\n102\t  // \u2500\u2500 Team CRUD \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n103\t  const openTmAdd  = () => { setSelected(null); setTmForm(blankMember()); setTmModal(true); };\n104\t  const openTmEdit = (m) => { setSelected(m); setTmForm({ name: m.name || '', role: m.role || '', bio: m.bio || '', photo_url: m.photo_url || '', display_order: m.display_order || 0 }); setTmModal(true); };\n105\t\n106\t  const saveTm = async (e) => {\n107\t    e.preventDefault();\n108\t    setSaving(p => ({ ...p, team: true }));\n109\t    try {\n110\t      const res = selected\n111\t        ? await apiService.put(`${API_ENDPOINTS.ADMIN.SETTINGS.TEAM}/${selected.id}`, tmForm)\n112\t        : await apiService.post(API_ENDPOINTS.ADMIN.SETTINGS.TEAM, tmForm);\n113\t      if (res.success) { setTmModal(false); fetchTeam(); showAlert('team', selected ? 'Member updated.' : 'Member added.'); }\n114\t      else showAlert('team', res.message || 'Save failed.', 'danger');\n115\t    } catch { showAlert('team', 'Failed to save team member.', 'danger'); }\n116\t    finally { setSaving(p => ({ ...p, team: false })); }\n117\t  };\n118\t\n119\t  const deleteTm = async (m) => {\n120\t    if (!window.confirm(`Remove team member \"${m.name}\"?`)) return;\n121\t    try {\n122\t      await apiService.delete(`${API_ENDPOINTS.ADMIN.SETTINGS.TEAM}/${m.id}`);\n123\t      fetchTeam(); showAlert('team', 'Member removed.');\n124\t    } catch { showAlert('team', 'Delete failed.', 'danger'); }\n125\t  };\n126\t\n127\t  const tlField = k => ({ value: tlForm[k], onChange: e => setTlForm(p => ({ ...p, [k]: e.target.value })) });\n128\t  const tmField = k => ({ value: tmForm[k], onChange: e => setTmForm(p => ({ ...p, [k]: e.target.value })) });\n129\t\n130\t  return (\n131\t    <PageShell title=\"Settings\" subtitle=\"Manage company timeline and team members\" error={error} onRetry={() => { fetchTimeline(); fetchTeam(); }}>\n132\t      <div className=\"as-page\">\n133\t        <div className=\"as-section-row row g-4\">\n134\t          {/* \u2500\u2500 Company Timeline \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */}\n135\t          <div className=\"col-12 col-sm-6\">\n136\t            <ResponsiveCard className=\"as-section-card\">\n137\t              <div className=\"as-section-head\">\n138\t                <div className=\"as-section-icon green\"><FaHistory /></div>\n139\t                <span className=\"as-section-title\">Company Timeline</span>\n140\t                <span className=\"as-section-count\">{timeline.length} entries</span>\n141\t                <div className=\"as-head-actions\">\n142\t                  <ResponsiveButton variant=\"outline-secondary\" size=\"sm\" className=\"as-btn add\" onClick={fetchTimeline} title=\"Refresh\">\n143\t                    <FaSync />\n144\t                  </ResponsiveButton>\n145\t                  <ResponsiveButton variant=\"primary\" size=\"sm\" className=\"as-btn add\" onClick={openTlAdd}>\n146\t                    <FaPlus />Add Entry\n147\t                  </ResponsiveButton>\n148\t                </div>\n149\t              </div>\n150\t              <div className=\"as-section-body\">\n151\t                <ResponsiveAlert show={!!alert.timeline?.msg} onHide={() => clearAlert('timeline')} message={alert.timeline?.msg} type={alert.timeline?.type} />\n152\t                {loading.timeline ? (\n153\t                  <div className=\"as-loading\"><div className=\"as-spinner\" />Loading timeline\u2026</div>\n154\t                ) : timeline.length === 0 ? (\n155\t                  <div className=\"as-empty\">\n156\t                    <div className=\"as-empty-icon\"><FaHistory /></div>\n157\t                    <div className=\"as-empty-text\">No timeline entries yet</div>\n158\t                    <div className=\"as-empty-sub\">Add your first milestone to showcase your journey</div>\n159\t                  </div>\n160\t                ) : (\n161\t                  <div className=\"as-entries\">\n162\t                    {timeline.map((item, idx) => (\n163\t                      <div className=\"as-entry-card\" key={item.id || idx}>\n164\t                        <div className=\"as-entry-head\">\n165\t                          <div className=\"as-entry-num\">{idx + 1}</div>\n166\t                          <span className=\"as-year-pill\">{item.year}</span>\n167\t                          <span className={`as-entry-title ${item.title ? '' : 'muted'}`}>{item.title || 'Untitled entry'}</span>\n168\t                          <div className=\"as-entry-actions\">\n169\t                            <button className=\"as-icon-btn\" title=\"Move up\"   disabled={idx === 0}                   onClick={() => moveTl(idx, -1)}><FaChevronUp /></button>\n170\t                            <button className=\"as-icon-btn\" title=\"Move down\" disabled={idx === timeline.length - 1} onClick={() => moveTl(idx, +1)}><FaChevronDown /></button>\n171\t                            <button className=\"as-icon-btn\" title=\"Edit\" onClick={() => openTlEdit(item)}><FaEdit /></button>\n172\t                            <button className=\"as-icon-btn danger\" title=\"Delete\" onClick={() => deleteTl(item)}><FaTrash /></button>\n173\t                          </div>\n174\t                        </div>\n175\t                        {item.description && (\n176\t                          <div className=\"as-entry-body\">\n177\t                            <p style={{ margin: 0, fontSize: '.875rem', color: '#6b7280' }}>{item.description}</p>\n178\t                          </div>\n179\t                        )}\n180\t                      </div>\n181\t                    ))}\n182\t                  </div>\n183\t                )}\n184\t              </div>\n185\t            </ResponsiveCard>\n186\t          </div>\n187\t\n188\t          {/* \u2500\u2500 Team Members \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */}\n189\t          <div className=\"col-12 col-sm-6\">\n190\t            <ResponsiveCard className=\"as-section-card\">\n191\t              <div className=\"as-section-head\">\n192\t                <div className=\"as-section-icon blue\"><FaUsers /></div>\n193\t                <span className=\"as-section-title\">Team Members</span>\n194\t                <span className=\"as-section-count\">{team.length} members</span>\n195\t                <div className=\"as-head-actions\">\n196\t                  <ResponsiveButton variant=\"outline-secondary\" size=\"sm\" className=\"as-btn add\" onClick={fetchTeam} title=\"Refresh\">\n197\t                    <FaSync />\n198\t                  </ResponsiveButton>\n199\t                  <ResponsiveButton variant=\"primary\" size=\"sm\" className=\"as-btn add\" onClick={openTmAdd}>\n200\t                    <FaPlus />Add Member\n201\t                  </ResponsiveButton>\n202\t                </div>\n203\t              </div>\n204\t              <div className=\"as-section-body\">\n205\t                <ResponsiveAlert show={!!alert.team?.msg} onHide={() => clearAlert('team')} message={alert.team?.msg} type={alert.team?.type} />\n206\t                {loading.team ? (\n207\t                  <div className=\"as-loading\"><div className=\"as-spinner\" />Loading team members\u2026</div>\n208\t                ) : team.length === 0 ? (\n209\t                  <div className=\"as-empty\">\n210\t                    <div className=\"as-empty-icon\"><FaUsers /></div>\n211\t                    <div className=\"as-empty-text\">No team members yet</div>\n212\t                    <div className=\"as-empty-sub\">Add members to display on your public page</div>\n213\t                  </div>\n214\t                ) : (\n215\t                  <div className=\"as-entries\">\n216\t                    {team.map((m, idx) => (\n217\t                      <div className=\"as-entry-card\" key={m.id || idx}>\n218\t                        <div className=\"as-entry-head\">\n219\t                          <div className=\"as-entry-num\">{idx + 1}</div>\n220\t                          {m.photo_url\n221\t                            ? <img className=\"as-avatar-preview\" src={m.photo_url} alt={m.name} loading=\"lazy\" style={{ width: 32, height: 32, borderRadius: '50%', objectFit: 'cover' }} />\n222\t                            : <div className=\"as-avatar-placeholder\" style={{ width: 32, height: 32, fontSize: '.9rem' }}><FaUserCircle /></div>}\n223\t                          <span className={`as-entry-title ${m.name ? '' : 'muted'}`}>\n224\t                            {m.name || 'Unnamed'}\n225\t                            {m.role && <span style={{ fontWeight: 400, color: '#9ca3af', marginLeft: '.4rem', fontSize: '.8rem' }}>\u2014 {m.role}</span>}\n226\t                          </span>\n227\t                          <div className=\"as-entry-actions\">\n228\t                            <button className=\"as-icon-btn\" title=\"Edit\" onClick={() => openTmEdit(m)}><FaEdit /></button>\n229\t                            <button className=\"as-icon-btn danger\" title=\"Remove\" onClick={() => deleteTm(m)}><FaTrash /></button>\n230\t                          </div>\n231\t                        </div>\n232\t                        {m.bio && (\n233\t                          <div className=\"as-entry-body\">\n234\t                            <p style={{ margin: 0, fontSize: '.875rem', color: '#6b7280' }}>{m.bio}</p>\n235\t                          </div>\n236\t                        )}\n237\t                      </div>\n238\t                    ))}\n239\t                </div>\n240\t              </ResponsiveCard>\n241\t          </div>\n242\t        </div>\n243\t      </div>\n244\t    </PageShell>\n245\t  );\n246\t};\n247\t\n248\texport default AdminSettings;\n249\t\n</system-reminder>"}, {"type": "text", "text": "<system-reminder>\nNote: C:\\Users\\01ker\\ArbiterCoffeeHUB\\frontend\\src\\pages\\barista\\PosPage.jsx was read before the last conversation was summarized, but the contents are too large to include. Use Read tool if you need to access it.\n</system-reminder>"}, {"type": "text", "text": "<system-reminder>\nNote: C:\\Users\\01ker\\ArbiterCoffeeHUB\\frontend\\src\\pages\\barista\\CompletedOrders.jsx was read before the last conversation was summarized, but the contents are too large to include. Use Read tool if you need to access it.\n</system-reminder>"}, {"type": "text", "text": "<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"C:\\\\Users\\\\01ker\\\\ArbiterCoffeeHUB\\\\frontend\\\\src\\\\pages\\\\auth\\\\ResetPasswordPage.jsx\"}\n</system-reminder>"}, {"type": "text", "text": "<system-reminder>\nResult of calling the Read tool:\n1\timport React, { useState, useMemo, useCallback } from 'react';\n2\timport { Link, useNavigate, useSearchParams } from 'react-router-dom';\n3\timport {\n4\t  FaLock, FaEye, FaEyeSlash, FaExclamationCircle,\n5\t  FaTimes, FaCheck, FaCircle, FaArrowLeft,\n6\t} from 'react-icons/fa';\n7\timport apiService from '../../services/api.service';\n8\timport { API_ENDPOINTS } from '../../config/api';\n9\timport { useToast } from '../../components/animations/Toast';\n10\timport { FadeIn, SlideInUp } from '../../components/animations/AnimationWrappers';\n11\timport './Auth.css';\n12\timport {\n13\t  ResponsiveButton,\n14\t  ResponsiveContainer,\n15\t  ResponsiveForm,\n16\t  ResponsiveRow,\n17\t  ResponsiveCol,\n18\t} from '@/components/responsive';\n19\t\n20\t/* \u2500\u2500 Password strength helper (same as RegisterPage) \u2500\u2500 */\n21\tconst getPasswordStrength = (pw) => {\n22\t  if (!pw) return { score: 0, label: '' };\n23\t  let score = 0;\n24\t  if (pw.length >= 8) score++;\n25\t  if (/[a-z]/.test(pw)) score++;\n26\t  if (/[A-Z]/.test(pw)) score++;\n27\t  if (/\\d/.test(pw)) score++;\n28\t  const labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];\n29\t  return { score, label: labels[score] };\n30\t};\n31\t\n32\tconst ResetPasswordPage = () => {\n33\t  const [searchParams] = useSearchParams();\n34\t  const token = searchParams.get('token') || '';\n35\t  const emailFromUrl = searchParams.get('email') || '';\n36\t\n37\t  const [password, setPassword] = useState('');\n38\t  const [passwordConfirmation, setPasswordConfirmation] = useState('');\n39\t  const [showPassword, setShowPassword] = useState(false);\n40\t  const [showConfirm, setShowConfirm] = useState(false);\n41\t  const [loading, setLoading] = useState(false);\n42\t  const [error, setError] = useState('');\n43\t  const [fieldErrors, setFieldErrors] = useState({});\n44\t\n45\t  const navigate = useNavigate();\n46\t  const toast = useToast();\n47\t\n48\t  const strength = useMemo(() => getPasswordStrength(password), [password]);\n49\t\n50\t  const pwReqs = useMemo(() => ({\n51\t    length: password.length >= 8,\n52\t    lower: /[a-z]/.test(password),\n53\t    upper: /[A-Z]/.test(password),\n54\t    digit: /\\d/.test(password),\n55\t  }), [password]);\n56\t\n57\t  const handleSubmit = useCallback(async (e) => {\n58\t    e.preventDefault();\n59\t\n60\t    if (!token || !emailFromUrl) {\n61\t      setError('This reset link is invalid or has expired. Please request a new one.');\n62\t      return;\n63\t    }\n64\t    if (password !== passwordConfirmation) {\n65\t      setError('Passwords do not match.');\n66\t      return;\n67\t    }\n68\t\n69\t    setLoading(true);\n70\t    setError('');\n71\t    setFieldErrors({});\n72\t\n73\t    try {\n74\t      await apiService.post(API_ENDPOINTS.AUTH.RESET_PASSWORD, {\n75\t        token,\n76\t        email: emailFromUrl,\n77\t        password,\n78\t        password_confirmation: passwordConfirmation,\n79\t      });\n80\t      toast.success('Password reset successfully! Please sign in.');\n81\t      navigate('/login');\n82\t    } catch (err) {\n83\t      const status = err?.response?.status;\n84\t      const data = err?.response?.data;\n85\t      if (status === 422 && data?.errors) {\n86\t        setFieldErrors(data.errors);\n87\t        setError(data.message || 'Please fix the errors below.');\n88\t      } else if (status === 400) {\n89\t        // Expired or invalid token\n90\t        setError(\n91\t          data?.message ||\n92\t          'This reset link has expired or is invalid. Please request a new one.'\n93\t        );\n94\t      } else if (status === 429) {\n95\t        setError('Too many attempts. Please wait before trying again.');\n96\t      } else {\n97\t        setError('An unexpected error occurred. Please try again.');\n98\t      }\n99\t    } finally {\n100\t      setLoading(false);\n101\t    }\n102\t  }, [token, emailFromUrl, password, passwordConfirmation, toast, navigate]);\n103\t\n104\t  const ReqItem = ({ met, children }) => (\n105\t    <span className={`auth-req-item${met ? ' met' : ''}`}>\n106\t      {met\n107\t        ? <FaCheck className=\"auth-req-icon\" aria-hidden=\"true\" />\n108\t        : <FaCircle className=\"auth-req-icon\" aria-hidden=\"true\" />\n109\t      }\n110\t      {children}\n111\t    </span>\n112\t  );\n113\t\n114\t  /* Invalid link \u2014 no token in URL */\n115\t  if (!token || !emailFromUrl) {\n116\t    return (\n117\t      <main role=\"main\" className=\"auth-page\">\n118\t        <div className=\"auth-brand-panel\" aria-hidden=\"true\">\n119\t          <div className=\"auth-brand-content\">\n120\t            <img src=\"/assets/arbiter-logo-white.png\" alt=\"\" className=\"auth-brand-logo\" />\n121\t            <h2 className=\"auth-brand-title\">Arbiter Coffee</h2>\n122\t            <p className=\"auth-brand-tagline\">\n123\t              Premium artisan coffee, crafted with care and delivered to&nbsp;your&nbsp;door.\n124\t            </p>\n125\t          </div>\n126\t          <div className=\"auth-brand-decoration\" />\n127\t          <div className=\"auth-brand-decoration-sm\" />\n128\t        </div>\n129\t        <div className=\"auth-form-panel\">\n130\t          <div className=\"auth-form-container\">\n131\t            <FadeIn duration={0.3}>\n132\t              <div className=\"auth-mobile-brand\">\n133\t                <img src=\"/assets/arbiter-logo.png\" alt=\"\" className=\"auth-mobile-logo\" />\n134\t                <span className=\"auth-mobile-name\">Arbiter Coffee</span>\n135\t              </div>\n136\t              <div className=\"auth-success-state\">\n137\t                <div className=\"auth-alert auth-alert--error\" role=\"alert\" style={{ marginBottom: 'var(--spacing-6)' }}>\n138\t                  <FaExclamationCircle className=\"auth-alert-icon\" aria-hidden=\"true\" />\n139\t                  <span>This reset link is invalid or missing. Please request a new one.</span>\n140\t                </div>\n141\t                <Link to=\"/forgot-password\" className=\"auth-submit-btn\" style={{ textDecoration: 'none', display: 'flex' }}>\n142\t                  Request New Link\n143\t                </Link>\n144\t              </div>\n145\t              <p className=\"auth-footer\">\n146\t                <Link to=\"/login\" className=\"auth-footer-link auth-footer-link--back\">\n147\t                  <FaArrowLeft aria-hidden=\"true\" />\n148\t                  Back to Sign In\n149\t                </Link>\n150\t              </p>\n151\t            </FadeIn>\n152\t          </div>\n153\t        </div>\n154\t      </main>\n155\t    );\n156\t  }\n157\t\n158\t  return (\n159\t    <main role=\"main\" className=\"auth-page\">\n160\t      {/* \u2500\u2500 Brand Panel (desktop only) \u2500\u2500 */}\n161\t      <div className=\"auth-brand-panel\" aria-hidden=\"true\">\n162\t        <div className=\"auth-brand-content\">\n163\t          <img\n164\t            src=\"/assets/arbiter-logo-white.png\"\n165\t            alt=\"\"\n166\t            className=\"auth-brand-logo\"\n167\t          />\n168\t          <h2 className=\"auth-brand-title\">Arbiter Coffee</h2>\n169\t          <p className=\"auth-brand-tagline\">\n170\t            Premium artisan coffee, crafted with care and delivered to&nbsp;your&nbsp;door.\n171\t          </p>\n172\t        </div>\n173\t        <div className=\"auth-brand-decoration\" />\n174\t        <div className=\"auth-brand-decoration-sm\" />\n175\t      </div>\n176\t\n177\t      {/* \u2500\u2500 Form Panel \u2500\u2500 */}\n178\t      <div className=\"auth-form-panel\">\n179\t        <ResponsiveContainer className=\"auth-form-container\">\n180\t          <FadeIn duration={0.3}>\n181\t            {/* Mobile brand header */}\n182\t            <div className=\"auth-mobile-brand\">\n183\t              <img src=\"/assets/arbiter-logo.png\" alt=\"\" className=\"auth-mobile-logo\" />\n184\t              <span className=\"auth-mobile-name\">Arbiter Coffee</span>\n185\t            </div>\n186\t\n187\t            <SlideInUp duration={0.4} delay={0.05}>\n188\t              <header className=\"auth-header\">\n189\t                <h1 id=\"reset-heading\" className=\"auth-heading\">Set New Password</h1>\n190\t                <p className=\"auth-subheading\">\n191\t                  Resetting password for <strong>{emailFromUrl}</strong>\n192\t                </p>\n193\t              </header>\n194\t\n195\t              {error && (\n196\t                <div className=\"auth-alert auth-alert--error\" role=\"alert\">\n197\t                  <FaExclamationCircle className=\"auth-alert-icon\" aria-hidden=\"true\" />\n198\t                  <span>{error}</span>\n199\t                  <button\n200\t                    type=\"button\"\n201\t                    className=\"auth-alert-dismiss\"\n202\t                    onClick={() => setError('')}\n203\t                    aria-label=\"Dismiss error\"\n204\t                  >\n205\t                    <FaTimes />\n206\t                  </button>\n207\t                </div>\n208\t              )}\n209\t\n210\t              <ResponsiveForm onSubmit={handleSubmit} aria-labelledby=\"reset-heading\" noValidate>\n211\t                {/* New Password */}\n212\t                <div className=\"auth-field\">\n213\t                  <label htmlFor=\"reset-password\" className=\"auth-field-label\">\n214\t                    <FaLock aria-hidden=\"true\" />\n215\t                    New Password\n216\t                    <span className=\"auth-field-required\" aria-label=\"required\">*</span>\n217\t                  </label>\n218\t                  <div className=\"auth-password-wrapper\">\n219\t                    <input\n220\t                      id=\"reset-password\"\n221\t                      type={showPassword ? 'text' : 'password'}\n222\t                      className={`auth-input${fieldErrors.password ? ' is-invalid' : ''}`}\n223\t                      value={password}\n224\t                      onChange={(e) => setPassword(e.target.value)}\n225\t                      required\n226\t                      placeholder=\"Create a strong password\"\n227\t                      autoComplete=\"new-password\"\n228\t                      aria-required=\"true\"\n229\t                      aria-invalid={fieldErrors.password ? 'true' : 'false'}\n230\t                      aria-describedby=\"reset-pw-reqs\"\n231\t                    />\n232\t                    <button\n233\t                      type=\"button\"\n234\t                      className=\"auth-password-toggle\"\n235\t                      onClick={() => setShowPassword((v) => !v)}\n236\t                      aria-label={showPassword ? 'Hide password' : 'Show password'}\n237\t                      tabIndex={-1}\n238\t                    >\n239\t                      {showPassword ? <FaEyeSlash /> : <FaEye />}\n240\t                    </button>\n241\t                  </div>\n242\t                  {fieldErrors.password && (\n243\t                    <span className=\"auth-field-error\" role=\"alert\">{fieldErrors.password[0]}</span>\n244\t                  )}\n245\t\n246\t                  {/* Strength meter */}\n247\t                  {password && (\n248\t                    <div className=\"auth-password-strength\" aria-live=\"polite\">\n249\t                      <div className=\"auth-strength-bar-track\">\n250\t                        <div className=\"auth-strength-bar-fill\" data-strength={strength.score} />\n251\t                      </div>\n252\t                      <div className=\"auth-strength-label\" data-strength={strength.score}>\n253\t                        {strength.label}\n254\t                      </div>\n255\t                    </div>\n256\t                  )}\n257\t\n258\t                  {/* Requirements checklist */}\n259\t                  <div className=\"auth-password-reqs\" id=\"reset-pw-reqs\">\n260\t                    <ReqItem met={pwReqs.length}>8+ characters</ReqItem>\n261\t                    <ReqItem met={pwReqs.lower}>Lowercase letter</ReqItem>\n262\t                    <ReqItem met={pwReqs.upper}>Uppercase letter</ReqItem>\n263\t                    <ReqItem met={pwReqs.digit}>Number</ReqItem>\n264\t                  </div>\n265\t                </div>\n266\t\n267\t                {/* Confirm Password */}\n268\t                <div className=\"auth-field\">\n269\t                  <label htmlFor=\"reset-password-confirm\" className=\"auth-field-label\">\n270\t                    <FaLock aria-hidden=\"true\" />\n271\t                    Confirm New Password\n272\t                    <span className=\"auth-field-required\" aria-label=\"required\">*</span>\n273\t                  </label>\n274\t                  <div className=\"auth-password-wrapper\">\n275\t                    <input\n276\t                      id=\"reset-password-confirm\"\n277\t                      type={showConfirm ? 'text' : 'password'}\n278\t                      className={`auth-input${\n279\t                        passwordConfirmation && passwordConfirmation !== password\n280\t                          ? ' is-invalid'\n281\t                          : ''\n282\t                      }`}\n283\t                      value={passwordConfirmation}\n284\t                      onChange={(e) => setPasswordConfirmation(e.target.value)}\n285\t                      required\n286\t                      placeholder=\"Re-enter your password\"\n287\t                      autoComplete=\"new-password\"\n288\t                      aria-required=\"true\"\n289\t                    />\n290\t                    <button\n291\t                      type=\"button\"\n292\t                      className=\"auth-password-toggle\"\n293\t                      onClick={() => setShowConfirm((v) => !v)}\n294\t                      aria-label={showConfirm ? 'Hide password' : 'Show password'}\n295\t                      tabIndex={-1}\n296\t                    >\n297\t                      {showConfirm ? <FaEyeSlash /> : <FaEye />}\n298\t                    </button>\n299\t                  </div>\n300\t                  {passwordConfirmation && passwordConfirmation !== password && (\n301\t                    <span className=\"auth-field-error\" role=\"alert\">Passwords do not match</span>\n302\t                  )}\n303\t                </div>\n304\t\n305\t                {/* Submit */}\n306\t                <button\n307\t                  type=\"submit\"\n308\t                  className=\"auth-submit-btn\"\n309\t                  disabled={\n310\t                    loading ||\n311\t                    !password ||\n312\t                    !passwordConfirmation ||\n313\t                    password !== passwordConfirmation ||\n314\t                    strength.score < 3\n315\t                  