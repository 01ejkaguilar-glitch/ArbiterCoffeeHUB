APP_NAME=ArbiterCoffeeHub
APP_ENV=production
APP_KEY= # Generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.arbitercoffeeshop.com
FRONTEND_URL=https://arbitercoffeeshop.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_JSON_FORMATTER=true

# Database Configuration - MySQL for production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u576753664_ArbiterCoffee  # Your database name (same as username on Hostinger)
DB_USERNAME=u576753664_ArbiterCoffee # Your database username
DB_PASSWORD=Aguilar#0121             # Your database password

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.arbitercoffeeshop.com

BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Redis Configuration
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST= # e.g., smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME= # your email username
MAIL_PASSWORD= # your email password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://arbitercoffeeshop.com

# Sanctum Settings (for SPA authentication)
SANCTUM_STATEFUL_DOMAINS=arbitercoffeeshop.com,api.arbitercoffeeshop.com

# Frontend URL (for redirect after login, etc.)
FRONTEND_URL=https://arbitercoffeeshop.com